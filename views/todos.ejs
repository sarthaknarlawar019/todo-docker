
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My Todo List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="container py-5">
        <div class="todo-card mx-auto">
            <h1 class="text-center mb-2">My Todo List</h1>
            <p class="text-center text-secondary mb-4">Plan your day. Get things done.</p>

            <form action="/todos" method="POST" class="d-flex gap-2 mb-4">
                <input class="form-control" name="title" placeholder="What needs to be done?" required>
                <button class="btn btn-primary">Add</button>
            </form>

            <h5 class="mb-3">Your tasks (<%= todos.length %>)</h5>

            <% if (todos.length === 0) { %>
                <p class="text-center text-secondary py-4">No tasks yet. Add your first one!</p>
            <% } %>

            <% todos.forEach(todo => { %>
                <div class="todo-item d-flex align-items-center gap-2">
                    <form action="/todos/<%= todo.id %>/toggle" method="POST">
                        <button class="btn btn-sm <%= todo.completed ? 'btn-success' : 'btn-outline-secondary' %>">
                            <%= todo.completed ? '✓' : '○' %>
                        </button>
                    </form>

                    <span class="flex-grow-1 <%= todo.completed ? 'completed' : '' %>">
                        <%= todo.title %>
                    </span>

                    <a href="/todos/<%= todo.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>

                    <form action="/todos/<%= todo.id %>/delete" method="POST"
                          onsubmit="return confirm('Delete this task?')">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            <% }) %>
        </div>
    </main>
</body>
</html>
